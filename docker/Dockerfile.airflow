FROM apache/airflow:2.10.3-python3.11

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps \
 && rm -rf /var/lib/apt/lists/* \
 # dbt lives in its own virtualenv so its dependencies never clash with Airflow's
 && python -m venv /opt/dbt_venv \
 && /opt/dbt_venv/bin/pip install --no-cache-dir dbt-core==1.8.8 dbt-postgres==1.8.2 \
 && chown -R airflow /opt/dbt_venv

USER airflow
RUN pip install --no-cache-dir pyspark==3.5.3 delta-spark==3.2.0

# Pre-download jars (same reason as Dockerfile.spark)
RUN python -c "from pyspark.sql import SparkSession; \
s = SparkSession.builder.master('local[1]').config('spark.jars.packages', \
'io.delta:delta-spark_2.12:3.2.0,org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.3,org.postgresql:postgresql:42.7.3').getOrCreate(); s.stop()"
